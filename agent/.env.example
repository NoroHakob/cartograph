# Copy to .env and fill in. .env is never committed.

# Gemini, the same key the app uses in .env.local.
GOOGLE_API_KEY=

# "scripted" replaces Gemini with a fixed script of real lookups, for testing
# the app → agent → tools path without a model. Leave unset for Gemini.
# CARTOGRAPH_MODEL=scripted

# The tool surface the agent's lookups call: the app's route, which reads the
# analysis named by each run's Ask credential. `pnpm ask:tools` in the app
# serves the checked-in fixture instead, at http://127.0.0.1:3999/tools.
CARTOGRAPH_TOOLS_URL=http://localhost:3000/api/ask/tools

# The app is this agent's only caller. Same value as MDA_INGRESS_SECRET in the
# app's .env.local; generate one with `openssl rand -hex 32`.
MDA_INGRESS_SECRET=

# LangSmith, for traces and Studio.
LANGSMITH_API_KEY=
