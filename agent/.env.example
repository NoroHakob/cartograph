# Copy to .env and fill in. .env is never committed.

# Gemini, the same key the app uses in .env.local.
GOOGLE_API_KEY=

# The tool surface the agent's lookups call. Locally: `pnpm ask:tools` in the app.
CARTOGRAPH_TOOLS_URL=http://127.0.0.1:3999

# LangSmith, for traces and Studio. MDA's local dev server and Studio expect a
# US-region key; see README.md if yours is EU.
LANGSMITH_API_KEY=
