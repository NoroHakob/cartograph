{
  "name": "cartograph",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "parse": "tsx src/parser/cli.ts",
    "analyze": "tsx --conditions=react-server --env-file=.env.local src/pipeline/cli.ts",
    "test:pipeline": "tsx --conditions=react-server --test src/pipeline/**/*.test.ts",
    "test:parser": "tsx --test src/parser/**/*.test.ts",
    "test:map": "tsx --test src/map/**/*.test.ts",
    "test:explain": "tsx --test src/explain/**/*.test.ts",
    "test:ask": "tsx --test src/ask/**/*.test.ts",
    "ask:tools": "tsx src/ask/dev-server.ts",
    "eval:build": "node --env-file=.env.local scripts/eval-build.mjs",
    "eval:roles": "node --env-file=.env.local scripts/eval-roles.mjs",
    "eval:prompts": "node --env-file=.env.local scripts/eval-prompts.mjs",
    "eval:paths": "node --env-file=.env.local scripts/eval-paths.mjs",
    "eval:ask": "node --env-file=.env.local scripts/eval-ask.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.16",
    "@dagrejs/dagre": "3.1.1",
    "@langchain/core": "1.2.18",
    "@langchain/google": "0.2.11",
    "@supabase/supabase-js": "^2.118.0",
    "@xyflow/react": "12.12.0",
    "ignore": "7.0.12",
    "langsmith": "0.11.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tar": "7.4.3",
    "ts-morph": "28.0.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.27.0"
}
